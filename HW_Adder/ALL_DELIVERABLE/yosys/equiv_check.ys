# ------------------------
# Read gold design
# ------------------------
read_verilog -sv RCA8/RCA8_generated.v
prep -top RCA8 -flatten
rename RCA8 gold
design -stash gold_design

# ------------------------
# Reset and read gate design
# ------------------------
design -reset
read_verilog -sv best_adder.v
prep -top RCA8 -flatten
rename RCA8 gate
design -stash gate_design

# ------------------------
# Bring both back
# ------------------------
design -reset
design -copy-from gold_design -as gold gold
design -copy-from gate_design -as gate gate

# ------------------------
# Equivalence checking
# ------------------------
equiv_make gold gate equiv
prep -top equiv
equiv_simple
equiv_status -assert